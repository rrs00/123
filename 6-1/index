const FONT="'NEXON Lv1 Gothic','Malgun Gothic',sans-serif";
const $=id=>document.getElementById(id);
const stage=$('stage'), sctx=stage.getContext('2d');
const graph=$('graph'), gctx=graph.getContext('2d');

let ctrl=PRESETS.basic.map(p=>p.slice());
let track=buildTrack(ctrl);
let mass=50, mu=0, speed=1, refMode='ground';
const refH=()=>refMode==='ground'?0:track.minY;
const sim={s:0.3,v:0,t:0,heat:0,E0:0,restTime:0,slow:0,ref:0};
let startS=0.3;
let running=false;
let hist=[], dots=[], records=[], runNo=1;
const curRecs=()=>records.filter(r=>r.run===runNo);
let nextHist=0, nextDot=0;
let selected=-1, drag=null;
let view={scale:40,ox:40,oy:0,W:800,H:420};
let lastTs=0, needsDraw=true;
['input','change','click','pointerdown','pointermove','pointerup','keydown','touchstart'].forEach(t=>document.addEventListener(t,()=>{needsDraw=true;},{capture:true,passive:true}));

function fricLabel(){ return mu===0?'없음':(mu<=0.03?'약함':(mu<=0.07?'보통':'강함'))+' ('+Math.round(mu*100)+')'; }
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const fmt=(v,d=2)=>v.toFixed(d);
const fmtJ=v=>Math.round(v).toLocaleString('ko-KR');

function energies(){
  const st=trackAt(track,sim.s);
  const h=st.y-refH(), pe=mass*G*h, ke=0.5*mass*sim.v*sim.v;
  return {st,h,v:Math.abs(sim.v),pe,ke,me:pe+ke,heat:sim.heat};
}

function setStatus(msg,alert=false){ const el=$('status'); el.textContent=msg; el.classList.toggle('alert',alert); }

function resetSim(msg,keepRun){
  running=false;
  if(!keepRun && curRecs().length){ runNo++; renderRecords(); }
  startS=clamp(startS,0.05,track.length-0.05);
  sim.s=startS; sim.v=0; sim.t=0; sim.heat=0; sim.restTime=0; sim.slow=0; sim.ref=refH();
  sim.E0=mass*G*(trackAt(track,sim.s).y-sim.ref);
  hist=[]; dots=[]; nextHist=0; nextDot=0;
  pushHist(); pushDot();
  updateUI();
  if(msg) setStatus(msg);
}

function pushHist(){ const e=energies(); hist.push({t:sim.t,pe:e.pe,ke:e.ke,heat:e.heat}); if(hist.length>4000) hist.shift(); nextHist+=0.05; }
function pushDot(){ const st=trackAt(track,sim.s); dots.push({x:st.x,y:st.y}); if(dots.length>800) dots.shift(); nextDot+=0.1; }

function rebuild(){
  const frac=startS/track.length;
  track=buildTrack(ctrl);
  startS=frac*track.length;
  resetSim();
}

function play(){
  if(running){ running=false; setStatus('일시정지했어요. 다시 누르면 이어서 움직여요.'); updateUI(); return; }
  if(sim.t===0){ sim.ref=refH(); sim.E0=mass*G*(trackAt(track,sim.s).y-sim.ref); }
  if(sim.s<=0 || sim.s>=track.length){ resetSim(null,true); }
  running=true; setStatus('롤러코스터가 움직이고 있어요. 에너지 막대를 관찰해 보세요.');
  updateUI();
}

function handleEvent(ev){
  if(ev==='end') setStatus('트랙 끝에 도달해서 멈췄어요. 트랙 끝을 더 높게 만들거나 출발 위치를 바꿔 보세요.',true);
  else if(ev==='rest'){
    if(mu>0 && sim.heat>0.5) setStatus('롤러코스터가 멈췄어요. 마찰 때문에 역학적 에너지의 일부가 열에너지 등으로 전환되었어요.',true);
    else setStatus('롤러코스터가 움직이지 않아요. 경사진 곳이나 더 높은 곳에서 출발시켜 보세요.',true);
  }
  updateUI();
}

function updateUI(){
  $('playBtn').textContent=running?'⏸ 일시정지':(sim.t>0?'▶ 이어서':'▶ 출발');
  $('mass').disabled=running; $('fric').disabled=running; $('preset').disabled=running; $('refSel').disabled=running;
  $('addPtBtn').disabled=running; $('delPtBtn').disabled=running||selected<0||ctrl.length<=3;
}

