let lastPointerType='mouse';
const HIT_PT=()=>lastPointerType==='touch'?26:18, HIT_CAR=()=>lastPointerType==='touch'?40:32;
function hitAt(px,py){
  let hit=-1, hd=HIT_PT();
  ctrl.forEach((p,i)=>{ const d=Math.hypot(wx(p[0])-px,wy(p[1])-py); if(d<hd){hd=d;hit=i;} });
  if(hit>=0) return {type:'pt',i:hit};
  const st=trackAt(track,sim.s);
  if(Math.hypot(wx(st.x)-st.ty*14-px,wy(st.y)-st.tx*14-py)<HIT_CAR()) return {type:'car'};
  return null;
}
// 손가락이 트랙 점이나 롤러코스터에 닿았을 때만 화면 스크롤을 막아요
stage.addEventListener('touchstart',ev=>{
  if(running) return;
  lastPointerType='touch';
  const r=stage.getBoundingClientRect(), t=ev.touches[0];
  if(hitAt(t.clientX-r.left,t.clientY-r.top)) ev.preventDefault();
},{passive:false});
function pointerPos(ev){ const r=stage.getBoundingClientRect(); return [ev.clientX-r.left, ev.clientY-r.top]; }
function nearestS(px,py){
  let best=1e18, bi=0;
  for(let i=0;i<track.xs.length;i++){
    const dx=wx(track.xs[i])-px, dy=wy(track.ys[i])-py, d=dx*dx+dy*dy;
    if(d<best){best=d;bi=i;}
  }
  return {s:track.cum[bi], d:Math.sqrt(best), i:bi};
}
stage.addEventListener('pointerdown',ev=>{
  if(running) return;
  lastPointerType=ev.pointerType||'mouse';
  const [px,py]=pointerPos(ev);
  const h=hitAt(px,py);
  if(h&&h.type==='pt'){ selected=h.i; drag=h; stage.setPointerCapture(ev.pointerId); updateUI(); return; }
  if(h&&h.type==='car'){ drag=h; stage.setPointerCapture(ev.pointerId); return; }
  selected=-1; updateUI();
});
stage.addEventListener('pointermove',ev=>{
  const [px,py]=pointerPos(ev);
  if(!drag){
    if(running){ stage.style.cursor='default'; return; }
    stage.style.cursor=hitAt(px,py)?'grab':'default';
    return;
  }
  stage.style.cursor='grabbing';
  if(drag.type==='pt'){
    const [x,y]=toWorld(px,py);
    ctrl[drag.i]=[clamp(x,0.2,WORLD_W-0.2),clamp(y,0,WORLD_H-0.2)];
    rebuild();
  } else if(drag.type==='car'){
    startS=clamp(nearestS(px,py).s,0.05,track.length-0.05);
    resetSim('출발 위치를 정했어요. ▶ 출발을 눌러 보세요.');
  }
});
const endDrag=()=>{ if(drag){ drag=null; stage.style.cursor='default'; } };
stage.addEventListener('pointerup',endDrag);
stage.addEventListener('pointercancel',endDrag);
stage.addEventListener('dblclick',ev=>{
  if(running) return;
  const [px,py]=pointerPos(ev);
  const n=nearestS(px,py);
  if(n.d>30) return;
  insertPointAt(n.i);
});

function insertPointAt(sampleIdx){
  const spanIdx=track.span[Math.min(sampleIdx,track.span.length-1)];
  ctrl.splice(spanIdx+1,0,[track.xs[sampleIdx],track.ys[sampleIdx]]);
  selected=spanIdx+1; rebuild();
  setStatus('트랙 점을 추가했어요. 점을 끌어서 모양을 바꿔 보세요.');
}

// ---------- 버튼 ----------
$('playBtn').onclick=play;
$('resetBtn').onclick=()=>resetSim('처음 위치로 돌아왔어요. 같은 조건이라 기록한 지점은 그대로 보여요.',true);
$('recordBtn').onclick=record;
$('addPtBtn').onclick=()=>{
  // 가장 긴 구간의 가운데에 점 추가
  let best=-1, bi=0;
  for(let i=0;i<ctrl.length-1;i++){
    const a=i*SAMPLES_PER_SPAN, b=(i+1)*SAMPLES_PER_SPAN, len=track.cum[b]-track.cum[a];
    if(len>best){best=len;bi=i;}
  }
  insertPointAt(bi*SAMPLES_PER_SPAN+SAMPLES_PER_SPAN/2);
};
$('delPtBtn').onclick=()=>{
  if(selected<0||ctrl.length<=3) return;
  ctrl.splice(selected,1); selected=-1; rebuild();
  setStatus('선택한 점을 지웠어요.');
};
$('preset').onchange=e=>{
  ctrl=PRESETS[e.target.value].map(p=>p.slice()); selected=-1;
  track=buildTrack(ctrl); startS=0.3; resetSim('트랙을 바꿨어요. ▶ 출발을 눌러 보세요.');
};
$('mass').oninput=e=>{ mass=+e.target.value; $('massOut').textContent=mass+' kg'; resetSim(); };
$('fric').oninput=e=>{ mu=+e.target.value; $('fricOut').textContent=fricLabel(); resetSim(); };
$('speed').onchange=e=>{ speed=+e.target.value; };
$('refSel').onchange=e=>{ refMode=e.target.value; resetSim(refMode==='ground'?'기준면을 땅으로 정했어요.':'기준면을 트랙의 가장 낮은 곳으로 정했어요. 그곳을 지날 때 위치 에너지가 0이 돼요.'); };
['showH','showStart','showDots'].forEach(id=>$(id).onchange=()=>{});

document.addEventListener('keydown',ev=>{
  const tag=(ev.target.tagName||'').toLowerCase();
  if(tag==='input'||tag==='select'||tag==='textarea') return;
  if(ev.code==='Space'){ ev.preventDefault(); play(); }
  else if(ev.key==='r'||ev.key==='R'){ record(); }
});

// ---------- 기록표 ----------
function labelFor(i){ return i<26?String.fromCharCode(65+i):String(i+1); }
function record(){
  const e=energies();
  records.push({run:runNo,label:labelFor(curRecs().length),t:sim.t,h:e.h,v:e.v,pe:e.pe,ke:e.ke,me:e.me,heat:e.heat,x:e.st.x,y:e.st.y,mass,fric:fricLabel().replace(/,/g,' '),ref:refMode==='ground'?'땅':'트랙의 가장 낮은 곳'});
  renderRecords();
  setStatus(`${runNo}회 실험의 ${records[records.length-1].label} 지점 값을 기록했어요.`);
}
function renderRecords(){
  const body=$('recBody');
  if(!records.length){ body.innerHTML='<tr><td colspan="9" class="empty">아직 기록이 없어요.</td></tr>'; return; }
  body.innerHTML=records.map(r=>`<tr class="${r.run===runNo?'':'old'}"><td>${r.run}회</td><td>${r.label}</td><td>${fmt(r.t)}</td><td>${fmt(r.h)}</td><td>${fmt(r.v)}</td><td class="pe">${fmtJ(r.pe)}</td><td class="ke">${fmtJ(r.ke)}</td><td class="me">${fmtJ(r.me)}</td><td class="heat">${fmtJ(r.heat)}</td></tr>`).join('');
}
$('clearRecBtn').onclick=()=>{ records=[]; runNo=1; renderRecords(); setStatus('기록을 모두 지웠어요.'); };
$('csvBtn').onclick=()=>{
  if(!records.length){ setStatus('저장할 기록이 없어요. 먼저 📍 지금 값 기록을 눌러 보세요.',true); return; }
  const head='실험,지점,시간(s),높이(m),속력(m/s),위치에너지(J),운동에너지(J),역학적에너지(J),열에너지 등(J),질량(kg),마찰,기준면';
  const rows=records.map(r=>[r.run+'회',r.label,fmt(r.t),fmt(r.h),fmt(r.v),Math.round(r.pe),Math.round(r.ke),Math.round(r.me),Math.round(r.heat),r.mass,r.fric,r.ref].join(','));
  const blob=new Blob(['\uFEFF'+head+'\n'+rows.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='롤러코스터_측정기록.csv';
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),1000);
};

// ---------- 시작 ----------
if(window.ResizeObserver) new ResizeObserver(resize).observe(stage.parentElement);
window.addEventListener('resize',resize);
resize(); resetSim(); requestAnimationFrame(frame);
</script>
</body>
