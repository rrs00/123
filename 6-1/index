function resize(){
  const dpr=window.devicePixelRatio||1;
  const W=stage.clientWidth;
  const small=W<600;
  const padL=small?10:14,padR=padL,padT=small?12:16,padB=small?26:34;
  const shortScreen=window.innerHeight<500;
  const maxH=Math.max(170,Math.min(620,window.innerHeight*(shortScreen?0.58:(small?0.5:0.7))));
  const scale=Math.min((W-padL-padR)/WORLD_W,(maxH-padT-padB)/WORLD_H);
  const H=Math.round(scale*WORLD_H+padT+padB);
  stage.style.height=H+'px';
  stage.width=Math.round(W*dpr); stage.height=Math.round(H*dpr);
  sctx.setTransform(dpr,0,0,dpr,0,0);
  view={scale,ox:padL+((W-padL-padR)-scale*WORLD_W)/2,oy:H-padB,W,H,small};
  needsDraw=true;
  const gw=graph.clientWidth, gh=graph.clientHeight;
  graph.width=Math.round(gw*dpr); graph.height=Math.round(gh*dpr);
  gctx.setTransform(dpr,0,0,dpr,0,0);
}
const wx=x=>view.ox+x*view.scale;
const wy=y=>view.oy-y*view.scale;
const toWorld=(px,py)=>[(px-view.ox)/view.scale,(view.oy-py)/view.scale];

// ---------- 그리기 ----------
function drawStage(){
  const c=sctx, {W,H,scale}=view;
  c.clearRect(0,0,W,H);
  // 하늘
  const sky=c.createLinearGradient(0,0,0,H);
  sky.addColorStop(0,'#cfe6ff'); sky.addColorStop(1,'#f4f9ff');
  c.fillStyle=sky; c.fillRect(0,0,W,H);
  // 땅
  c.fillStyle='#8fcf7a'; c.fillRect(0,wy(0),W,H-wy(0));
  c.fillStyle='#78b964'; c.fillRect(0,wy(0),W,4);

  const ref=refH();
  c.fillStyle='#2f5a24'; c.font='bold 12px '+FONT; c.textAlign='left'; c.textBaseline='top';
  c.fillText(refMode==='ground'?'기준면 (땅)':'땅',wx(0)+4,wy(0)+8);
  if(refMode!=='ground'){
    c.setLineDash([10,5]); c.strokeStyle='#2f7a1f'; c.lineWidth=2;
    c.beginPath(); c.moveTo(wx(0),wy(ref)); c.lineTo(wx(WORLD_W),wy(ref)); c.stroke(); c.setLineDash([]);
    c.fillStyle='#2f7a1f'; c.textBaseline='bottom'; c.fillText(view.small?'기준면':'기준면 (트랙의 가장 낮은 곳)',wx(0)+4,wy(ref)-3);
  }

  // 기둥
  c.strokeStyle='rgba(90,100,120,.35)'; c.lineWidth=2;
  let lastX=-99;
  for(let i=0;i<track.xs.length;i+=4){
    const x=track.xs[i], y=track.ys[i];
    if(Math.abs(x-lastX)<0.7 || y<0.15) continue;
    lastX=x; c.beginPath(); c.moveTo(wx(x),wy(y)); c.lineTo(wx(x),wy(0)); c.stroke();
  }

  // 출발 높이선
  if($('showStart').checked){
    const h0=trackAt(track,startS).y;
    c.setLineDash([7,6]); c.strokeStyle='rgba(122,63,209,.8)'; c.lineWidth=1.5;
    c.beginPath(); c.moveTo(wx(0),wy(h0)); c.lineTo(wx(WORLD_W),wy(h0)); c.stroke(); c.setLineDash([]);
    const sx=trackAt(track,startS).x, lbl='출발 높이 '+fmt(h0-ref)+' m';
    c.font='bold 12px '+FONT; c.textBaseline='bottom';
    const lw=c.measureText(lbl).width; let lx=wx(sx)+26;
    if(lx+lw>W-6) lx=wx(sx)-26-lw;
    c.textAlign='left'; c.fillStyle='rgba(255,255,255,.8)'; c.fillRect(lx-3,wy(h0)-19,lw+6,16);
    c.fillStyle='#7a3fd1'; c.fillText(lbl,lx,wy(h0)-4);
  }

  // 레일
  c.lineJoin='round'; c.lineCap='round';
  c.beginPath(); c.moveTo(wx(track.xs[0]),wy(track.ys[0]));
  for(let i=1;i<track.xs.length;i++) c.lineTo(wx(track.xs[i]),wy(track.ys[i]));
  c.strokeStyle='#3a4254'; c.lineWidth=7; c.stroke();
  c.strokeStyle='#c9d0dc'; c.lineWidth=2; c.stroke();
  // 침목
  c.strokeStyle='#3a4254'; c.lineWidth=2;
  for(let s=0;s<track.length;s+=0.45){
    const st=trackAt(track,s); const nx=-st.ty, ny=st.tx; const k=6;
    c.beginPath(); c.moveTo(wx(st.x)+nx*k,wy(st.y)-ny*k); c.lineTo(wx(st.x)-nx*k,wy(st.y)+ny*k); c.stroke();
  }

  // 다중 섬광
  if($('showDots').checked){
    c.fillStyle='rgba(224,69,58,.55)';
    for(const d of dots){ c.beginPath(); c.arc(wx(d.x),wy(d.y),4,0,Math.PI*2); c.fill(); }
  }

  // 기록 지점
  c.font='bold 13px '+FONT; c.textAlign='center'; c.textBaseline='middle';
  for(const r of curRecs()){
    const px=wx(r.x), py=wy(r.y);
    c.fillStyle='#1c2333'; c.beginPath(); c.arc(px,py,4,0,Math.PI*2); c.fill();
    c.fillStyle='#fff'; c.strokeStyle='#1c2333'; c.lineWidth=1.5;
    c.beginPath(); c.roundRect ? c.roundRect(px-10,py+10,20,18,5) : c.rect(px-10,py+10,20,18); c.fill(); c.stroke();
    c.fillStyle='#1c2333'; c.fillText(r.label,px,py+19);
  }

  // 조절점
  if(!running){
    ctrl.forEach((p,i)=>{
      const pr=view.small?8:6.5; c.beginPath(); c.arc(wx(p[0]),wy(p[1]),i===selected?pr+2:pr,0,Math.PI*2);
      c.fillStyle=i===selected?'#159a72':'#fff'; c.fill();
      c.strokeStyle='#159a72'; c.lineWidth=2.5; c.stroke();
    });
  }

  const e=energies(), st=e.st;
  // 높이 표시
  if($('showH').checked){
    c.setLineDash([4,4]); c.strokeStyle='#2f6fdf'; c.lineWidth=1.5;
    c.beginPath(); c.moveTo(wx(st.x),wy(st.y)); c.lineTo(wx(st.x),wy(ref)); c.stroke(); c.setLineDash([]);
    c.fillStyle='#2f6fdf'; c.font='bold 13px '+FONT; c.textAlign='left'; c.textBaseline='middle';
    const ly=(wy(st.y)+wy(ref))/2;
    const txt='h = '+fmt(e.h)+' m';
    const tw=c.measureText(txt).width;
    let lx=wx(st.x)+6; if(lx+tw>W-4) lx=wx(st.x)-6-tw;
    c.fillStyle='rgba(255,255,255,.85)'; c.fillRect(lx-3,ly-10,tw+6,20);
    c.fillStyle='#2f6fdf'; c.fillText(txt,lx,ly);
  }

  // 롤러코스터
  const L=clamp(scale*1.0,26,50), Hh=L*0.46;
  c.save(); c.translate(wx(st.x),wy(st.y)); c.rotate(-Math.atan2(st.ty,st.tx));
  // 바퀴
  c.fillStyle='#2b2f3a';
  c.beginPath(); c.arc(-L*0.3,-4,L*0.1,0,Math.PI*2); c.arc(L*0.3,-4,L*0.1,0,Math.PI*2); c.fill();
  // 몸체
  c.fillStyle='#e0453a'; c.strokeStyle='#8f1f18'; c.lineWidth=1.5;
  c.beginPath();
  if(c.roundRect) c.roundRect(-L/2,-4-Hh,L,Hh,[6,6,3,3]); else c.rect(-L/2,-4-Hh,L,Hh);
  c.fill(); c.stroke();
  c.fillStyle='#ffd166'; c.fillRect(-L*0.36,-4-Hh*0.8,L*0.72,Hh*0.28);
  c.restore();
}

function drawGraph(){
  const c=gctx, W=graph.clientWidth, H=graph.clientHeight;
  c.clearRect(0,0,W,H);
  const padL=58,padR=12,padT=10,padB=28;
  const pw=W-padL-padR, ph=H-padT-padB;
  const win=20;
  const tEnd=Math.max(win,sim.t), tStart=tEnd-win;
  const Emax=Math.max(sim.E0,1)*1.1;
  const X=t=>padL+(t-tStart)/win*pw, Y=e=>padT+ph-(e/Emax)*ph;
  // 축
  c.strokeStyle='#dfe3ec'; c.lineWidth=1; c.font='11px '+FONT; c.fillStyle='#5b6478';
  c.textAlign='right'; c.textBaseline='middle';
  for(let i=0;i<=4;i++){
    const e=Emax/1.1*i/4, y=Y(e);
    c.beginPath(); c.moveTo(padL,y); c.lineTo(W-padR,y); c.stroke();
    c.fillText(fmtJ(e)+' J',padL-6,y);
  }
  c.textAlign='center'; c.textBaseline='top';
  const stp=pw<420?5:2;
  for(let t=Math.ceil(tStart/stp)*stp;t<=tEnd+1e-9;t+=stp){
    const x=X(t); c.beginPath(); c.moveTo(x,padT); c.lineTo(x,padT+ph); c.stroke();
    c.fillText(t+' s',x,padT+ph+6);
  }
  c.strokeStyle='#1c2333'; c.lineWidth=1.5; c.beginPath(); c.moveTo(padL,padT); c.lineTo(padL,padT+ph); c.lineTo(W-padR,padT+ph); c.stroke();
  const vis=hist.filter(h=>h.t>=tStart-0.1);
  const line=(fn,color,w=2.2)=>{
    if(vis.length<1) return;
    c.strokeStyle=color; c.lineWidth=w; c.beginPath();
    vis.forEach((h,i)=>{ const x=X(h.t), y=Y(fn(h)); i?c.lineTo(x,y):c.moveTo(x,y); });
    c.stroke();
  };
  const cs=getComputedStyle(document.documentElement);
  line(h=>h.heat,cs.getPropertyValue('--heat'));
  line(h=>h.pe,cs.getPropertyValue('--pe'));
  line(h=>h.ke,cs.getPropertyValue('--ke'));
  line(h=>h.pe+h.ke,cs.getPropertyValue('--me'),3);
}

