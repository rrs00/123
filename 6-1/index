// ---------- 애니메이션 ----------
function frame(ts){
  const dtReal=lastTs?Math.min(0.05,(ts-lastTs)/1000):0; lastTs=ts;
  if(running){
    let remain=dtReal*speed;
    const h=0.0005;
    while(remain>1e-9){
      const d=Math.min(h,remain);
      const ev=stepSim(sim,track,mass,mu,d);
      remain-=d;
      while(sim.t>=nextHist) pushHist();
      while(sim.t>=nextDot) pushDot();
      if(ev){ running=false; handleEvent(ev); break; }
    }
  }
  if(running||needsDraw){ drawStage(); drawPanel(); drawGraph(); needsDraw=false; }
  requestAnimationFrame(frame);
}

