<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>롤러코스터 에너지 실험실</title>
<meta name="description" content="롤러코스터로 위치 에너지와 운동 에너지의 전환, 역학적 에너지 보존을 확인하는 중학교 과학 가상 실험">
<style>
  @font-face{font-family:'NEXON Lv1 Gothic';font-weight:400;font-style:normal;font-display:swap;
    src:url(data:font/woff2;base64,) format('woff2');}
  :root{
    --bg:#f3f5fa; --panel:#ffffff; --ink:#1c2333; --muted:#5b6478; --line:#dfe3ec;
    --pe:#2f6fdf; --ke:#e5487e; --me:#7a3fd1; --heat:#ef8a17; --accent:#159a72;
    --radius:14px; --gap:14px;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;background:var(--bg);color:var(--ink);
    font-family:'NEXON Lv1 Gothic',"Malgun Gothic","맑은 고딕","Apple SD Gothic Neo",sans-serif}
  body{padding-bottom:env(safe-area-inset-bottom)}
  header{padding:16px 20px 4px;max-width:1280px;margin:0 auto}
  header h1{margin:0;font-size:clamp(20px,2.6vw,28px);letter-spacing:-0.5px}
  header p{margin:6px 0 0;color:var(--muted);font-size:14px;line-height:1.5}

  main{max-width:1280px;margin:0 auto;padding:10px 16px 24px;display:grid;gap:var(--gap);
    grid-template-columns:minmax(0,1fr) 320px;
    grid-template-areas:"stage energy" "set energy" "graph graph" "rec rec";align-items:start}
  #stageCard{grid-area:stage} #energy{grid-area:energy} #settings{grid-area:set}
  #graphCard{grid-area:graph} #recCard{grid-area:rec}

  .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
    padding:14px;box-shadow:0 1px 2px rgba(20,30,60,.04);min-width:0}
  .card h2{font-size:15px;margin:0 0 10px;letter-spacing:-0.3px}
  #stageWrap{position:relative;width:100%}
  #stage{width:100%;display:block;border-radius:10px;touch-action:pan-y;cursor:default;background:#e8f2fd;
    -webkit-user-select:none;user-select:none}
  #status{margin:8px 2px 0;font-size:14px;color:var(--muted);min-height:1.4em;line-height:1.5}
  #status.alert{color:#b3261e}

  button,select,input,label{touch-action:manipulation}
  button{font:inherit;font-size:15px;border:1px solid var(--line);background:#fff;color:var(--ink);
    min-height:44px;padding:8px 14px;border-radius:12px;cursor:pointer;transition:background .15s}
  button:hover{background:#f1f4f9}
  button:active{transform:translateY(1px)}
  button:disabled{opacity:.45;cursor:not-allowed}
  button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  button.primary:hover{background:#0f8563}
  button.small{min-height:38px;padding:6px 12px;font-size:14px}
  .actions{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:8px;margin-top:10px}
  .actions button{white-space:nowrap}

  .grid-ctrl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px 20px}
  .ctrl label{display:flex;justify-content:space-between;align-items:center;font-size:15px;margin-bottom:4px}
  .ctrl output{color:var(--accent)}
  .ctrl select{width:100%;font:inherit;font-size:16px;min-height:44px;padding:8px 10px;border-radius:10px;
    border:1px solid var(--line);background:#fff;color:var(--ink)}
  .ctrl .hint{font-size:12.5px;color:var(--muted);margin-top:2px;line-height:1.4}
  .editrow{display:flex;gap:8px;margin-top:8px}
  .editrow button{flex:1}

  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:34px;background:transparent;margin:0}
  input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:#d6dbe6}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;
    background:var(--accent);border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.35);margin-top:-10px}
  input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:#d6dbe6}
  input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--accent);
    border:3px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.35)}
  input[type=range]:disabled{opacity:.45}

  .checks{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:15px;margin-top:14px}
  .checks label{display:flex;align-items:center;gap:7px;cursor:pointer;min-height:36px}
  .checks input{accent-color:var(--accent);width:20px;height:20px;margin:0}

  /* 에너지 막대 */
  .e0legend{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);margin:-4px 0 6px}
  .e0legend i{display:inline-block;width:22px;border-top:2px dashed #9aa3b5}
  .bars{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:end;height:220px;
    padding:6px 4px 0;border-bottom:2px solid var(--ink);position:relative}
  .bar{position:relative;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}
  .bar .fill{width:70%;border-radius:6px 6px 0 0;min-height:1px}
  .bar .val{position:relative;z-index:1;background:rgba(255,255,255,.9);padding:0 3px;border-radius:4px;font-size:12.5px;margin-bottom:3px;white-space:nowrap;font-variant-numeric:tabular-nums}
  .barlabels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;text-align:center;font-size:12.5px;line-height:1.3}
  .pe{color:var(--pe)} .ke{color:var(--ke)} .me{color:var(--me)} .heat{color:var(--heat)}
  .fill.pe{background:var(--pe)} .fill.ke{background:var(--ke)} .fill.me{background:var(--me)} .fill.heat{background:var(--heat)}
  .e0line{position:absolute;left:0;right:0;border-top:2px dashed #9aa3b5;pointer-events:none}

  .readout{margin-top:14px;font-size:14px;line-height:1.7}
  .readout .row{display:flex;justify-content:space-between;border-bottom:1px dashed var(--line);padding:2px 0}
  .readout .row b{font-weight:400;font-variant-numeric:tabular-nums}
  .formula{margin-top:10px;background:#f7f8fc;border-radius:10px;padding:10px;font-size:13px;line-height:1.65;font-variant-numeric:tabular-nums}
  .formula div{white-space:normal;word-break:keep-all}
  .note{font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.5}

  .legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:13px;margin-bottom:6px}
  .legend span{display:flex;align-items:center;gap:5px}
  .legend i{display:inline-block;width:18px;height:4px;border-radius:2px}
  #graph{width:100%;height:210px;display:block}

  .rechead{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
  .rechead h2{margin:0}
  .rechead div{display:flex;gap:8px}
  table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
  th,td{border-bottom:1px solid var(--line);padding:7px 6px;text-align:right;white-space:nowrap}
  th{background:#f5f7fb;font-weight:400;text-align:center}
  td:first-child,td:nth-child(2){text-align:center}
  tr.old td{color:#9aa3b5 !important}
  .tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:8px}
  .empty{color:var(--muted);text-align:center !important;padding:14px;font-size:13px}
  .mobile-only{display:none}
  footer{max-width:1280px;margin:0 auto;padding:0 20px 28px;color:var(--muted);font-size:12px;line-height:1.6}

  /* ---------- 태블릿·휴대폰 ---------- */
  @media (max-width:980px){
    main{grid-template-columns:minmax(0,1fr);grid-template-areas:"stage" "energy" "set" "graph" "rec"}
    .bars{height:150px}
    .readout{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;line-height:1.3}
    .readout .row{flex-direction:column;align-items:center;border:1px solid var(--line);border-radius:10px;padding:6px 4px;text-align:center}
    .readout .row span{font-size:12px;color:var(--muted)}
    .readout .row b{font-size:16px}
  }
  @media (max-width:600px){
    :root{--gap:10px}
    header{padding:12px 14px 2px}
    header h1{font-size:20px}
    header p{display:none}
    main{padding:8px 8px 20px}
    .card{padding:10px;border-radius:12px}
    .card h2{font-size:14px;margin-bottom:8px}
    #status{font-size:13px}
    .actions button{font-size:14px;padding:8px 6px}
    .grid-ctrl{grid-template-columns:1fr 1fr;gap:12px 12px}
    .grid-ctrl .wide{grid-column:1 / -1}
    .ctrl label{font-size:14px}
    .ctrl .hint{display:none}
    .checks{font-size:14px;gap:2px 14px}
    .bars{height:130px;gap:6px}
    .bar .val{font-size:11.5px}
    .barlabels{font-size:11.5px;gap:6px}
    .formula{font-size:12.5px}
    #graph{height:170px}
    .legend{font-size:12px}
    table{font-size:12px}
    th,td{padding:6px 5px}
    .desk-only{display:none}
    .mobile-only{display:block}
    footer{padding:0 14px 20px;font-size:11.5px}
  }
  /* 휴대폰 가로 화면: 트랙과 에너지 막대를 나란히 */
  @media (max-height:500px) and (orientation:landscape){
    header{padding:8px 14px 0} header h1{font-size:18px} header p{display:none}
    main{padding:6px 8px 16px;gap:8px;grid-template-columns:minmax(0,1fr) 250px;
      grid-template-areas:"stage energy" "set energy" "graph graph" "rec rec"}
    .card{padding:8px}
    #status{font-size:12.5px;margin-top:4px}
    .actions{margin-top:6px} .actions button{min-height:40px}
    #energy h2{display:none}
    .bars{height:120px}
    .barlabels,.bar .val{font-size:11px}
    .readout{margin-top:8px}
    .readout .row b{font-size:13px;white-space:nowrap}
    .desk-only{display:none}
    .formula{font-size:12px;padding:8px}
  }
</style>
</head>
<body>
<header>
  <h1>🎢 롤러코스터 에너지 실험실</h1>
  <p>롤러코스터가 트랙을 따라 움직일 때 <b class="pe">위치 에너지</b>와 <b class="ke">운동 에너지</b>가 어떻게 바뀌는지, 두 에너지의 합인 <b class="me">역학적 에너지</b>는 어떻게 되는지 관찰해 보세요.</p>
</header>

<main>
  <!-- 실험 화면 -->
  <section class="card" id="stageCard">
    <div id="stageWrap"><canvas id="stage" aria-label="롤러코스터 트랙 실험 화면"></canvas></div>
    <div id="status">롤러코스터를 끌어서 출발 위치를 정하고, 트랙 위의 동그란 점을 끌어 트랙 모양을 바꿀 수 있어요.</div>
    <div class="actions">
      <button id="playBtn" class="primary">▶ 출발</button>
      <button id="resetBtn">↺ 처음으로</button>
      <button id="recordBtn">📍 기록</button>
    </div>
  </section>

  <!-- 에너지 막대 -->
  <aside class="card" id="energy">
    <h2>에너지 막대그래프</h2>
    <div class="e0legend"><i></i>처음 역학적 에너지</div>
    <div class="bars" id="bars">
      <div class="bar"><div class="val pe" id="vPe">0 J</div><div class="fill pe" id="bPe"></div></div>
      <div class="bar"><div class="val ke" id="vKe">0 J</div><div class="fill ke" id="bKe"></div></div>
      <div class="bar"><div class="val me" id="vMe">0 J</div><div class="fill me" id="bMe"></div></div>
      <div class="bar"><div class="val heat" id="vHeat">0 J</div><div class="fill heat" id="bHeat"></div></div>
      <div class="e0line" id="e0line"></div>
    </div>
    <div class="barlabels">
      <div class="pe">위치<br>에너지</div><div class="ke">운동<br>에너지</div><div class="me">역학적<br>에너지</div><div class="heat">열에너지 등<br>(마찰)</div>
    </div>
    <div class="readout">
      <div class="row"><span>시간</span><b id="rT">0.00 s</b></div>
      <div class="row"><span>높이<span class="desk-only"> (기준면에서)</span></span><b id="rH">0.00 m</b></div>
      <div class="row"><span>속력</span><b id="rV">0.00 m/s</b></div>
    </div>
    <div class="formula">
      <div class="pe" id="fPe">위치 에너지 = 9.8 × 질량 × 높이</div>
      <div class="ke" id="fKe">운동 에너지 = ½ × 질량 × 속력²</div>
      <div class="me" id="fMe">역학적 에너지 = 위치 에너지 + 운동 에너지</div>
    </div>
    <div class="note">에너지 값은 반올림해서 보여 주므로 1 J 정도 차이가 날 수 있어요.</div>
  </aside>

  <!-- 실험 조건 -->
  <section class="card" id="settings">
    <h2>실험 조건</h2>
    <div class="grid-ctrl">
      <div class="ctrl wide">
        <label for="preset">트랙 모양</label>
        <select id="preset">
          <option value="basic">언덕 두 개</option>
          <option value="valley">U자 계곡</option>
          <option value="steps">점점 낮아지는 언덕</option>
          <option value="higher">출발점보다 높은 언덕</option>
          <option value="loop">루프(고리) 트랙</option>
        </select>
        <div class="editrow">
          <button id="addPtBtn" class="small">＋ 트랙 점 추가</button>
          <button id="delPtBtn" class="small">－ 선택한 점 삭제</button>
        </div>
      </div>
      <div class="ctrl wide">
        <label for="mass">질량 <output id="massOut">50 kg</output></label>
        <input type="range" id="mass" min="10" max="200" step="10" value="50">
      </div>
      <div class="ctrl wide">
        <label for="fric">마찰 <output id="fricOut">없음</output></label>
        <input type="range" id="fric" min="0" max="0.1" step="0.01" value="0">
        <div class="hint">맨 왼쪽(없음)은 마찰과 공기 저항을 무시하는 경우예요.</div>
      </div>
      <div class="ctrl">
        <label for="refSel">기준면</label>
        <select id="refSel">
          <option value="ground">땅</option>
          <option value="low">트랙 가장 낮은 곳</option>
        </select>
        <div class="hint">기준면에서 위치 에너지가 0이에요.</div>
      </div>
      <div class="ctrl">
        <label for="speed">재생 속도</label>
        <select id="speed">
          <option value="0.25">0.25배</option>
          <option value="0.5">0.5배</option>
          <option value="1" selected>1배 (실제)</option>
        </select>
      </div>
    </div>
    <div class="checks">
      <label><input type="checkbox" id="showH" checked> 높이 표시</label>
      <label><input type="checkbox" id="showStart" checked> 출발 높이선</label>
      <label><input type="checkbox" id="showDots"> 0.1초 간격 위치</label>
    </div>
  </section>

  <!-- 시간-에너지 그래프 -->
  <section class="card" id="graphCard">
    <h2>시간에 따른 에너지 변화</h2>
    <div class="legend">
      <span class="pe"><i style="background:var(--pe)"></i>위치 에너지</span>
      <span class="ke"><i style="background:var(--ke)"></i>운동 에너지</span>
      <span class="me"><i style="background:var(--me)"></i>역학적 에너지</span>
      <span class="heat"><i style="background:var(--heat)"></i>열에너지 등</span>
    </div>
    <canvas id="graph"></canvas>
  </section>

  <!-- 측정 기록 -->
  <section class="card" id="recCard">
    <div class="rechead">
      <h2>측정 기록표</h2>
      <div>
        <button id="csvBtn" class="small">⬇ CSV 저장</button>
        <button id="clearRecBtn" class="small">기록 지우기</button>
      </div>
    </div>
    <div class="note"><b>📍 기록</b>을 누르면 그 순간의 값이 A, B, C… 지점으로 기록돼요. 실험 조건을 바꾸면 새 회차로 넘어가요.<span class="desk-only"> (단축키: 스페이스바 = 출발/일시정지, R = 기록)</span></div>
    <div class="tablewrap">
      <table>
        <thead><tr><th>실험</th><th>지점</th><th>시간(s)</th><th>높이(m)</th><th>속력(m/s)</th><th class="pe">위치 에너지(J)</th><th class="ke">운동 에너지(J)</th><th class="me">역학적 에너지(J)</th><th class="heat">열에너지 등(J)</th></tr></thead>
        <tbody id="recBody"><tr><td colspan="9" class="empty">아직 기록이 없어요.</td></tr></tbody>
      </table>
    </div>
    <div class="note mobile-only">표가 잘리면 옆으로 밀어서 보세요 →</div>
  </section>
</main>

<footer>
  모델 가정: 중력 가속도 9.8 m/s², 롤러코스터를 하나의 점으로 보고 레일 위 지점의 높이를 사용합니다. 실제 롤러코스터처럼 바퀴가 레일에 고정되어 있어 트랙에서 떨어지지 않습니다.
  마찰은 ‘운동 방향과 반대로 작용하는 힘’으로 단순화했고, 공기 저항은 마찰에 포함해 생각합니다.<br>2015 개정 교육과정 중학교 과학 [9과22-01] 에너지 전환과 보존 단원의 적용·심화 활동용 가상 실험입니다.
</footer>

<script>
// ==PHYSICS START==
const G = 9.8;                 // 중력 가속도 (교과서 값)
const WORLD_W = 20, WORLD_H = 10;
const SAMPLES_PER_SPAN = 40;

const PRESETS = {
  basic:  [[0.8,8.5],[3,4.2],[5.5,1],[8,4.6],[10.5,6],[13,2.2],[15.5,0.8],[18,4],[19.3,9.3]],
  valley: [[0.8,8],[3,3.2],[6,0.9],[10,0.5],[14,0.9],[17,3.2],[19.2,8.8]],
  steps:  [[0.8,9],[2.8,1.2],[5,7],[7.2,1.2],[9.6,5],[12,1.2],[14.3,3],[16.6,0.8],[19.3,9.3]],
  higher: [[0.8,6],[3.3,2],[5.8,0.8],[8.6,5],[10.8,8.2],[13,5],[15.8,1.2],[19.2,6.5]],
  loop:   [[0.8,9],[3,5.2],[5.5,1.6],[8.6,1.1],[11,2.2],[11.6,4.6],[10.1,6.4],[8.3,5.2],[8.4,2.6],[10.8,1.1],[14,1.3],[17,4.5],[19.3,9.5]]
};

// 센트리피털 캣멀-롬 스플라인 (뾰족한 꺾임 없이 점을 부드럽게 잇기)
function crPoint(p0,p1,p2,p3,t){
  const tj=(a,b)=>Math.pow(Math.hypot(b[0]-a[0],b[1]-a[1]),0.5)||1e-4;
  const t0=0, t1=t0+tj(p0,p1), t2=t1+tj(p1,p2), t3=t2+tj(p2,p3);
  const u=t1+(t2-t1)*t;
  const L=(a,b,ta,tb)=>{const w=(u-ta)/(tb-ta);return [a[0]+(b[0]-a[0])*w, a[1]+(b[1]-a[1])*w];};
  const A1=L(p0,p1,t0,t1), A2=L(p1,p2,t1,t2), A3=L(p2,p3,t2,t3);
  const B1=L(A1,A2,t0,t2), B2=L(A2,A3,t1,t3);
  return L(B1,B2,t1,t2);
}

function buildTrack(ctrl){
  const n=ctrl.length;
  const P=i=>{
    if(i<0) return [2*ctrl[0][0]-ctrl[1][0], 2*ctrl[0][1]-ctrl[1][1]];
    if(i>=n) return [2*ctrl[n-1][0]-ctrl[n-2][0], 2*ctrl[n-1][1]-ctrl[n-2][1]];
    return ctrl[i];
  };
  const xs=[], ys=[], span=[];
  for(let i=0;i<n-1;i++){
    const p0=P(i-1),p1=P(i),p2=P(i+1),p3=P(i+2);
    for(let k=0;k<SAMPLES_PER_SPAN;k++){
      const q=crPoint(p0,p1,p2,p3,k/SAMPLES_PER_SPAN);
      xs.push(q[0]); ys.push(q[1]); span.push(i);
    }
  }
  xs.push(ctrl[n-1][0]); ys.push(ctrl[n-1][1]); span.push(n-2);
  const cum=[0];
  for(let i=1;i<xs.length;i++) cum.push(cum[i-1]+Math.hypot(xs[i]-xs[i-1],ys[i]-ys[i-1]));
  const tx=[], ty=[];
  for(let i=0;i<xs.length;i++){
    const a=Math.max(0,i-1), b=Math.min(xs.length-1,i+1);
    const dx=xs[b]-xs[a], dy=ys[b]-ys[a], d=Math.hypot(dx,dy)||1;
    tx.push(dx/d); ty.push(dy/d);
  }
  return {xs,ys,cum,span,tx,ty,length:cum[cum.length-1],minY:Math.min(...ys)};
}

function trackAt(tr,s){
  const c=tr.cum;
  if(s<0) s=0; if(s>tr.length) s=tr.length;
  let lo=0, hi=c.length-1;
  while(hi-lo>1){ const mid=(lo+hi)>>1; if(c[mid]<=s) lo=mid; else hi=mid; }
  const segS=(c[hi]-c[lo])||1e-9, f=(s-c[lo])/segS;
  const dx=tr.xs[hi]-tr.xs[lo], dy=tr.ys[hi]-tr.ys[lo], segLen=Math.hypot(dx,dy)||1e-9;
  let tx=tr.tx[lo]+(tr.tx[hi]-tr.tx[lo])*f, ty=tr.ty[lo]+(tr.ty[hi]-tr.ty[lo])*f;
  const tn=Math.hypot(tx,ty)||1; tx/=tn; ty/=tn;
  return {x:tr.xs[lo]+dx*f, y:tr.ys[lo]+dy*f, sin:dy/segLen, cos:dx/segLen, tx, ty, idx:lo};
}

// 한 단계 시뮬레이션. 트랙 방향 운동 방정식 + 에너지 장부(역학적 에너지 + 열에너지 = 처음 에너지)
function stepSim(sim,tr,m,mu,dt){
  const st=trackAt(tr,sim.s);
  const fr=mu*G*Math.abs(st.cos);   // 마찰에 의한 감속 (단순 모델)
  const drive=-G*st.sin;            // 중력의 트랙 방향 성분
  let a;
  sim.t+=dt;
  if(sim.v===0){
    if(Math.abs(drive)<1e-9 || Math.abs(drive)<=fr){
      sim.restTime+=dt;
      return sim.restTime>0.5 ? 'rest' : null;
    }
    a=drive-Math.sign(drive)*fr;
  } else {
    a=drive-Math.sign(sim.v)*fr;
  }
  sim.restTime=0;
  const v0=sim.v;
  let v1=v0+a*dt;
  if(v0!==0 && Math.sign(v1)!==Math.sign(v0)) v1=0;   // 방향이 바뀌는 순간(최고점)
  const ds=0.5*(v0+v1)*dt;
  sim.s+=ds; sim.v=v1;
  sim.heat+=m*fr*Math.abs(ds);
  if(sim.s<=0 || sim.s>=tr.length){
    sim.s=Math.min(Math.max(sim.s,0),tr.length); sim.v=0;
    return 'end';
  }
  // 수치 오차 보정: 운동 에너지 = 처음 에너지 − 열에너지 − 위치 에너지
  if(mu>0){
    sim.slow = Math.abs(sim.v)<0.05 ? sim.slow+dt : 0;
    if(sim.slow>2){ sim.v=0; return 'rest'; }
  }
  const h=trackAt(tr,sim.s).y-(sim.ref||0);
  const k=sim.E0-sim.heat-m*G*h;
  if(Math.abs(sim.v)>0.05 && k>0) sim.v=Math.sign(sim.v)*Math.sqrt(2*k/m);
  return null;
}
// ==PHYSICS END==

